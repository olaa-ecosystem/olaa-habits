# Add only documented, non-secret variable names. Never commit real secrets.

# Firebase web config (platform ADR-0004). Public by design: it identifies the project and
# grants no access; Firebase Auth and Firestore rules enforce access.
# Leave empty to run local-only (no sign-in, no sync, no Language auto check-ins).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Addresses of the other Olaa apps, for "Study now" and "Open in Olaa Note" links.
# Defaults: https://olaa-language.web.app/ and https://olaa-takenote.web.app/
VITE_OLAA_LANGUAGE_URL=
VITE_OLAA_TAKENOTE_URL=
